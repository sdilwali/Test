# Copy to .env.local and fill in. .env.local is gitignored; never commit real
# values, and never prefix any of these with NEXT_PUBLIC_ — that would inline
# them into the browser bundle.

# ── Supabase ───────────────────────────────────────────────────────────────
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Secret key (sb_secret_...). Bypasses Row Level Security entirely, so it is
# server-only: it must never appear in a client component, a NEXT_PUBLIC_ var,
# or a log line.
SUPABASE_SECRET_KEY=

# Publishable key (sb_publishable_...). Safe for the browser; respects RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Postgres ───────────────────────────────────────────────────────────────
# Transaction-mode pooler (port 6543). What the app runs queries through.
DATABASE_URL=

# Direct connection (port 5432). Migrations only — the pooler cannot run DDL
# reliably in transaction mode.
DIRECT_URL=

# ── Application-level encryption ───────────────────────────────────────────
# 32 bytes, base64. Encrypts the fields the spec names for encryption at rest:
# medical notes, allergies, insurance member ID. Disk encryption is not enough
# for children's medical data.
#   openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# ── Anthropic ──────────────────────────────────────────────────────────────
# Extraction only. Runs on inbound provider email, never on kid profiles —
# see the typed boundary in src/lib/pii.ts.
ANTHROPIC_API_KEY=
